<UserControl
    x:Class="SurveyController.App.StrategyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App"
    Loaded="OnLoaded">
    <Grid MinHeight="520" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactQuestionEditor">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorSearchRow.Height" Value="Auto" />
                        <Setter Target="QuestionSearch.(Grid.Row)" Value="1" />
                        <Setter Target="QuestionSearch.(Grid.Column)" Value="0" />
                        <Setter Target="QuestionSearch.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="QuestionTreeColumn.Width" Value="*" />
                        <Setter Target="QuestionDetailColumn.Width" Value="0" />
                        <Setter Target="QuestionTreeRow.Height" Value="250" />
                        <Setter Target="QuestionDetailRow.Height" Value="*" />
                        <Setter Target="QuestionDetailScroll.(Grid.Row)" Value="1" />
                        <Setter Target="QuestionDetailScroll.(Grid.Column)" Value="0" />
                        <Setter Target="LocationCityColumn.Width" Value="0" />
                        <Setter Target="LocationDistrictColumn.Width" Value="0" />
                        <Setter Target="LocationCityRow.Height" Value="Auto" />
                        <Setter Target="LocationDistrictRow.Height" Value="Auto" />
                        <Setter Target="LocationCity.(Grid.Row)" Value="1" />
                        <Setter Target="LocationCity.(Grid.Column)" Value="0" />
                        <Setter Target="LocationDistrict.(Grid.Row)" Value="2" />
                        <Setter Target="LocationDistrict.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideQuestionEditor">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorSearchRow.Height" Value="0" />
                        <Setter Target="QuestionSearch.(Grid.Row)" Value="0" />
                        <Setter Target="QuestionSearch.(Grid.Column)" Value="1" />
                        <Setter Target="QuestionSearch.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="QuestionTreeColumn.Width" Value="300" />
                        <Setter Target="QuestionDetailColumn.Width" Value="*" />
                        <Setter Target="QuestionTreeRow.Height" Value="*" />
                        <Setter Target="QuestionDetailRow.Height" Value="0" />
                        <Setter Target="QuestionDetailScroll.(Grid.Row)" Value="0" />
                        <Setter Target="QuestionDetailScroll.(Grid.Column)" Value="1" />
                        <Setter Target="LocationCityColumn.Width" Value="*" />
                        <Setter Target="LocationDistrictColumn.Width" Value="*" />
                        <Setter Target="LocationCityRow.Height" Value="0" />
                        <Setter Target="LocationDistrictRow.Height" Value="0" />
                        <Setter Target="LocationCity.(Grid.Row)" Value="0" />
                        <Setter Target="LocationCity.(Grid.Column)" Value="1" />
                        <Setter Target="LocationDistrict.(Grid.Row)" Value="0" />
                        <Setter Target="LocationDistrict.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EditorSearchRow" Height="0" />
            </Grid.RowDefinitions>
            <AutoSuggestBox x:Name="QuestionSearch" Grid.Column="1" Width="360" HorizontalAlignment="Center" PlaceholderText="查找题号、题干或选项" QueryIcon="Find" TextChanged="OnQuestionSearchChanged" SuggestionChosen="OnQuestionSuggestionChosen" QuerySubmitted="OnQuestionQuerySubmitted" AutomationProperties.Name="搜索题目" />
        </Grid>

        <Grid x:Name="QuestionEditorPanel" Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QuestionTreeColumn" Width="300" />
                <ColumnDefinition x:Name="QuestionDetailColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="QuestionTreeRow" Height="*" />
                <RowDefinition x:Name="QuestionDetailRow" Height="0" />
            </Grid.RowDefinitions>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource WizardCardCornerRadius}" Padding="8">
                <TreeView x:Name="QuestionTree" SelectionMode="Single" SelectionChanged="OnQuestionSelected" ItemInvoked="OnQuestionInvoked" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="问卷题目结构">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Content}" HorizontalContentAlignment="Stretch" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <ScrollViewer x:Name="QuestionDetailScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                <StackPanel Padding="4,0,8,20" Spacing="16">
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource WizardCardCornerRadius}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="QuestionTypeIcon" FontSize="18" />
                                <TextBlock x:Name="QuestionTitle" FontSize="21" FontWeight="SemiBold" Text="选择题目" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ContentControl x:Name="QuestionTypeBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="题型" />
                                <ContentControl x:Name="RequiredBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="必答" Background="{ThemeResource RequiredBadgeBackgroundBrush}" Foreground="{ThemeResource RequiredBadgeForegroundBrush}" Visibility="Collapsed" />
                                <ContentControl x:Name="MediaBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="图片题" Background="{ThemeResource MediaBadgeBackgroundBrush}" Foreground="{ThemeResource MediaBadgeForegroundBrush}" Visibility="Collapsed" />
                                <ContentControl x:Name="ConditionalDisplayBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="条件显示" Background="{ThemeResource ConditionalDisplayBadgeBackgroundBrush}" Foreground="{ThemeResource ConditionalDisplayBadgeForegroundBrush}" Visibility="Collapsed" />
                                <ContentControl x:Name="ControlsDisplayBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="控制后续" Background="{ThemeResource ControlsDisplayBadgeBackgroundBrush}" Foreground="{ThemeResource ControlsDisplayBadgeForegroundBrush}" Visibility="Collapsed" />
                                <ContentControl x:Name="JumpBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="跳题" Background="{ThemeResource JumpBadgeBackgroundBrush}" Foreground="{ThemeResource JumpBadgeForegroundBrush}" Visibility="Collapsed" />
                                <ContentControl x:Name="UnsupportedBadge" Style="{StaticResource WizardTextBadgeStyle}" Content="暂不支持" Background="{ThemeResource UnsupportedBadgeBackgroundBrush}" Foreground="{ThemeResource UnsupportedBadgeForegroundBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="QuestionMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="WeightSettingsSection" Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="基础策略" />
                        <RadioButtons x:Name="Bias" Header="选项预设" MaxColumns="4" SelectedIndex="0" SelectionChanged="OnBiasChanged" AutomationProperties.Name="选项预设">
                            <RadioButton Content="自定义" Tag="custom" />
                            <RadioButton Content="偏左" Tag="left" />
                            <RadioButton Content="居中" Tag="center" />
                            <RadioButton Content="偏右" Tag="right" />
                        </RadioButtons>
                        <StackPanel x:Name="OptionWeightsSection" Spacing="8">
                            <Grid><TextBlock FontWeight="SemiBold" Text="选项比例" /><TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="拖动滑块调整" /></Grid>
                            <ItemsRepeater x:Name="OptionWeightRows">
                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:OptionWeight">
                                        <Grid ColumnSpacing="12" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
                                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" StepFrequency="{x:Bind Step}" Value="{x:Bind Value, Mode=TwoWay}" AutomationProperties.Name="选项比例滑块" />
                                            <NumberBox Grid.Column="2" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" SmallChange="{x:Bind Step}" SpinButtonPlacementMode="Compact" Value="{x:Bind Value, Mode=TwoWay}" AutomationProperties.Name="选项比例" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock x:Name="RatioPreview" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="OptionWeightEmpty" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="此题无需设置选项比例" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                            <StackPanel x:Name="TextQuestionSection" Spacing="12">
                                <RadioButtons x:Name="TextRandomMode" Header="填空模式" MaxColumns="3" SelectionChanged="OnTextModeChanged" AutomationProperties.Name="填空模式">
                                    <RadioButton Content="答案文本" Tag="none" />
                                    <RadioButton Content="随机姓名" Tag="name" />
                                    <RadioButton Content="随机手机号" Tag="mobile" />
                                    <RadioButton Content="随机身份证" Tag="id_card" />
                                    <RadioButton Content="随机整数" Tag="integer" />
                                </RadioButtons>
                                <TextBox x:Name="TextAnswers" Header="答案文本" PlaceholderText="每行一个候选答案" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" TextChanged="OnQuestionTextChanged" AutomationProperties.Name="填空答案文本" />
                                <Grid x:Name="TextRangeRow" Visibility="Collapsed" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TextRangeMin" Header="整数最小值" SpinButtonPlacementMode="Compact" ValueChanged="OnQuestionNumberChanged" />
                                    <NumberBox x:Name="TextRangeMax" Grid.Column="1" Header="整数最大值" SpinButtonPlacementMode="Compact" ValueChanged="OnQuestionNumberChanged" />
                                </Grid>
                                <ToggleSwitch x:Name="AIEnabled" Header="允许 AI 填空" OffContent="关" OnContent="开" Toggled="OnAIEnabledToggled" AutomationProperties.Name="允许 AI 填空" />
                            </StackPanel>
                            <StackPanel x:Name="FillableOptionsSection" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="可填写选项" />
                                <StackPanel x:Name="FillableOptionList" Spacing="8" AutomationProperties.Name="可填写选项列表" />
                            </StackPanel>
                            <Grid x:Name="LocationSection" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LocationCityColumn" Width="*" /><ColumnDefinition x:Name="LocationDistrictColumn" Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="LocationCityRow" Height="0" /><RowDefinition x:Name="LocationDistrictRow" Height="0" /></Grid.RowDefinitions>
                                <TextBox x:Name="LocationProvince" Header="省" TextChanged="OnQuestionTextChanged" />
                                <TextBox x:Name="LocationCity" Grid.Column="1" Header="市" TextChanged="OnQuestionTextChanged" />
                                <TextBox x:Name="LocationDistrict" Grid.Column="2" Header="区县" TextChanged="OnQuestionTextChanged" />
                            </Grid>
                            <StackPanel x:Name="MultiTextSection" Spacing="8"><TextBlock FontWeight="SemiBold" Text="多项填空" /><TextBox x:Name="MultiTextAnswers" Header="答案文本组合" PlaceholderText="每行一组，各空用 || 分隔" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" TextChanged="OnQuestionTextChanged" AutomationProperties.Name="多项填空答案文本" /><StackPanel x:Name="MultiTextRows" Spacing="8" /></StackPanel>
                            <StackPanel x:Name="AttachedOptionSection" Spacing="8"><TextBlock FontWeight="SemiBold" Text="嵌入式下拉" /><StackPanel x:Name="AttachedOptionSelectList" Spacing="8" AutomationProperties.Name="嵌入式下拉选项" /></StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel x:Name="StatusPanel" Grid.Row="2" Spacing="8">
            <InfoBar x:Name="QuestionStatus" IsOpen="False" IsClosable="False" MaxWidth="720" />
        </StackPanel>
    </Grid>
</UserControl>
