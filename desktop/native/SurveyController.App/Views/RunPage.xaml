<Page
    x:Class="SurveyController.App.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SectionCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WizardCardCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RunScrollViewer" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{x:Bind RunScrollViewer.ViewportWidth, Mode=OneWay}" MaxWidth="820" Padding="24,24,24,32" HorizontalAlignment="Left" Spacing="16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="运行" />

            <!-- 启动 -->
            <Border Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Send" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="规模与启动" />
                    </StackPanel>
                    <InfoBar
                        x:Name="CheckStatus"
                        IsOpen="False"
                        IsClosable="False"
                        AutomationProperties.AutomationId="RunCheckStatusInfoBar" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="TargetCount" Header="目标提交份数" Minimum="1" Maximum="999999" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RunTargetCountBox" ValueChanged="OnExecutionChanged" />
                        <NumberBox x:Name="ThreadCount" Grid.Column="1" Header="并发线程数" Minimum="1" Maximum="128" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RunThreadCountBox" ValueChanged="OnExecutionChanged" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="0">
                        <Grid MinHeight="32">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="问卷" />
                            <TextBlock x:Name="ReviewSurvey" HorizontalAlignment="Right" FontWeight="SemiBold" AutomationProperties.AutomationId="RunReviewSurveyText" TextWrapping="Wrap" />
                        </Grid>
                        <Grid MinHeight="32">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="平台与题目" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="ReviewProvider" FontWeight="SemiBold" AutomationProperties.AutomationId="RunReviewProviderText" />
                                <TextBlock x:Name="ReviewQuestions" FontWeight="SemiBold" AutomationProperties.AutomationId="RunReviewQuestionsText" />
                            </StackPanel>
                        </Grid>
                        <Grid MinHeight="32">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="网络与信度" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="ReviewNetwork" FontWeight="SemiBold" AutomationProperties.AutomationId="RunReviewNetworkText" />
                                <TextBlock x:Name="ReviewReliability" FontWeight="SemiBold" AutomationProperties.AutomationId="RunReviewReliabilityText" />
                            </StackPanel>
                        </Grid>
                        <Grid MinHeight="32">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="作答时长" />
                            <TextBlock x:Name="ReviewDuration" HorizontalAlignment="Right" FontWeight="SemiBold" AutomationProperties.AutomationId="RunReviewDurationText" />
                        </Grid>
                        <Grid MinHeight="32">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="问卷地址" />
                            <TextBlock x:Name="ReviewUrl" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="RunReviewUrlText" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                    <Button
                        x:Name="StartButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnCheckAndStart"
                        AutomationProperties.Name="检查并启动作答"
                        AutomationProperties.AutomationId="RunStartButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Send" /><TextBlock Text="检查并启动作答" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 监控 -->
            <Border x:Name="MonitorCard" Visibility="Collapsed" Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="任务监控" />
                    </StackPanel>
                    <InfoBar
                        x:Name="RunStatus"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="尚未启动"
                        Message="确认配置后点击「检查并启动作答」。"
                        AutomationProperties.AutomationId="RunStatusInfoBar" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="1" Value="0" Height="8" VerticalAlignment="Center" CornerRadius="4" AutomationProperties.AutomationId="RunProgressBar" />
                        <TextBlock x:Name="RunProgressText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="RunProgressText" Text="0 / 0" MinWidth="72" TextAlignment="Right" />
                    </Grid>

                    <Border x:Name="RunResultCard" Visibility="Collapsed" Padding="16,12" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="成功份数" />
                                <TextBlock x:Name="RunResultSuccess" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="RunSuccessText" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="失败份数" />
                                <TextBlock x:Name="RunResultFail" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="RunFailText" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="提交合计" />
                                <TextBlock x:Name="RunResultTotal" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="RunTotalText" Text="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseButton" Content="暂停任务" IsEnabled="False" Click="OnPauseRun" AutomationProperties.AutomationId="RunPauseButton" />
                        <Button x:Name="ResumeButton" Content="继续任务" IsEnabled="False" Click="OnResumeRun" AutomationProperties.AutomationId="RunResumeButton" />
                        <Button x:Name="StopButton" Content="停止任务" IsEnabled="False" Click="OnStopRun" AutomationProperties.AutomationId="RunStopButton" />
                        <Button x:Name="ExportResultButton" Visibility="Collapsed" Content="导出作答结果" Click="OnExportResult" AutomationProperties.AutomationId="RunExportResultButton" />
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="实时日志" />
                            <Button x:Name="ExportLogsButton" Visibility="Collapsed" HorizontalAlignment="Right" Content="导出日志" Click="OnExportLogs" AutomationProperties.AutomationId="RunExportLogsButton" />
                        </Grid>
                        <ListView x:Name="RunLogs" Grid.Row="1" Margin="0,8,0,0" AutomationProperties.AutomationId="RunLogsList" SelectionMode="None" />
                    </Grid>

                    <InfoBar
                        x:Name="RunExportStatus"
                        IsOpen="False"
                        IsClosable="False"
                        AutomationProperties.AutomationId="RunExportStatusInfoBar" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
