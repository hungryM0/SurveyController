<Page
    x:Class="SurveyController.App.TimingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SectionCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WizardCardCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="TimingScrollViewer" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{x:Bind TimingScrollViewer.ViewportWidth, Mode=OneWay}" MaxWidth="760" Padding="24,24,24,32" HorizontalAlignment="Left" Spacing="16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="时间" />

            <InfoBar
                x:Name="TimingStatus"
                IsOpen="False"
                IsClosable="False"
                MaxWidth="720"
                AutomationProperties.AutomationId="TimingStatusInfoBar" />

            <!-- 节奏 -->
            <Border Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Clock" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="作答节奏" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="单份作答时长（秒）" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="AnswerDurationMin" Header="最短" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="TimingDurationMinBox" ValueChanged="OnNumberChanged" />
                                <NumberBox x:Name="AnswerDurationMax" Grid.Column="1" Header="最长" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="TimingDurationMaxBox" ValueChanged="OnNumberChanged" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="提交间隔冷却（秒）" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="SubmitIntervalMin" Header="最短" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="TimingIntervalMinBox" ValueChanged="OnNumberChanged" />
                                <NumberBox x:Name="SubmitIntervalMax" Grid.Column="1" Header="最长" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="TimingIntervalMaxBox" ValueChanged="OnNumberChanged" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 时间窗口 -->
            <Border Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Calendar" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="有效作答时间窗口" />
                    </StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="留空表示不限制；填写时日期与时间必须成对，且开始早于结束。" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <CalendarDatePicker x:Name="WindowStartDate" Header="开始日期" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="TimingWindowStartDatePicker" DateChanged="OnWindowDateChanged" />
                            <TimePicker x:Name="WindowStartTime" Header="开始时间" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="TimingWindowStartTimePicker" SelectedTimeChanged="OnWindowTimeChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <CalendarDatePicker x:Name="WindowEndDate" Header="结束日期" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="TimingWindowEndDatePicker" DateChanged="OnWindowDateChanged" />
                            <TimePicker x:Name="WindowEndTime" Header="结束时间" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="TimingWindowEndTimePicker" SelectedTimeChanged="OnWindowTimeChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 异常处理 -->
            <Border Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="4">
                    <Grid MinHeight="40">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="连续失败时自动停止" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="避免无效配置持续消耗资源" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FailStop" HorizontalAlignment="Right" AutomationProperties.Name="连续失败时停止" AutomationProperties.AutomationId="TimingFailStopToggle" OffContent="关" OnContent="开" Toggled="OnToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid MinHeight="40">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="遇到验证码时自动暂停" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="暂停等待人工处理后可继续任务" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PauseCaptcha" HorizontalAlignment="Right" AutomationProperties.Name="遇到验证码时暂停" AutomationProperties.AutomationId="TimingPauseCaptchaToggle" OffContent="关" OnContent="开" Toggled="OnToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Excel 反填 -->
            <Border Style="{StaticResource SectionCardBorder}">
                <Grid MinHeight="48">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Excel 反填" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="按表格内容覆盖对应答案" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ReverseFillButton" Click="OnChooseReverseFill" AutomationProperties.Name="选择 Excel 反填文件" AutomationProperties.AutomationId="TimingReverseFillPickButton">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile" /><TextBlock x:Name="ReverseFillButtonLabel" Text="选择 Excel" /></StackPanel>
                        </Button>
                        <ToggleSwitch x:Name="ReverseFillEnabled" AutomationProperties.Name="启用 Excel 反填" AutomationProperties.AutomationId="TimingReverseFillToggle" OffContent="关" OnContent="开" Toggled="OnToggled" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
