<Page
    x:Class="SurveyController.App.AnswersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App"
    Loaded="OnLoaded"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SectionCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WizardCardCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="StatsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatsValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="AnswersScrollViewer" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{x:Bind AnswersScrollViewer.ViewportWidth, Mode=OneWay}" Padding="24,24,24,32" HorizontalAlignment="Left" Spacing="16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="作答" />

            <InfoBar
                x:Name="AnswersHint"
                IsOpen="True"
                IsClosable="False"
                MaxWidth="720"
                Severity="Informational"
                Title="答案策略"
                Message="逐题权重、随机填充与 AI 填空在「编辑逐题答案」中配置；条件跳转规则在下方维护。保存后由后端统一校验。"
                AutomationProperties.AutomationId="AnswersHintInfoBar" />

            <Border Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Edit" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="逐题答案" />
                        <Button
                            Margin="12,0,0,0"
                            Click="OnEditAnswers"
                            AutomationProperties.Name="编辑逐题答案"
                            AutomationProperties.AutomationId="AnswersEditButton">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Edit" /><TextBlock Text="编辑逐题答案" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="总题数" />
                            <TextBlock x:Name="TotalCount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="AnswersTotalCountText" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="已配置" />
                            <TextBlock x:Name="ConfiguredCount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="AnswersConfiguredCountText" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="AI 题" />
                            <TextBlock x:Name="AICount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="AnswersAiCountText" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="异常" />
                            <TextBlock x:Name="ProblemCount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="AnswersProblemCountText" Text="0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4,0,0">
                <SymbolIcon Symbol="Important" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="条件规则" />
            </StackPanel>
            <local:RuleEditor x:Name="RuleEditorView" />
        </StackPanel>
    </ScrollViewer>
</Page>
