<Page
    x:Class="SurveyController.App.SurveyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SectionCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WizardCardCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="StatsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatsValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="SurveyScrollViewer" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{x:Bind SurveyScrollViewer.ViewportWidth, Mode=OneWay}" MaxWidth="760" Padding="24,24,24,32" HorizontalAlignment="Left" Spacing="16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="问卷" />

            <InfoBar
                x:Name="SurveyStatus"
                IsOpen="False"
                IsClosable="False"
                MaxWidth="720"
                AutomationProperties.AutomationId="SurveyStatusInfoBar" />

            <!-- 导入 -->
            <Border Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Document" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="导入问卷" />
                    </StackPanel>
                    <TextBox
                        x:Name="SurveyUrl"
                        Header="问卷地址"
                        AutomationProperties.Name="问卷链接"
                        AutomationProperties.AutomationId="SurveyUrlInput"
                        PlaceholderText="粘贴 HTTP / HTTPS 问卷链接"
                        TextChanged="OnSurveyUrlChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ParseButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnParse"
                            AutomationProperties.Name="解析问卷"
                            AutomationProperties.AutomationId="SurveyParseButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon x:Name="ParseIcon" Symbol="Refresh" />
                                <TextBlock x:Name="ParseLabel" Text="解析并继续" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnChooseQRCode" AutomationProperties.Name="识别二维码图片" AutomationProperties.AutomationId="SurveyQrButton">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="View" /><TextBlock Text="识别二维码" /></StackPanel>
                        </Button>
                        <Button Click="OnImportConfig" AutomationProperties.Name="导入配置文件" AutomationProperties.AutomationId="SurveyImportButton">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile" /><TextBlock Text="导入配置 (.json)" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 概要 -->
            <Border x:Name="ParsedCard" Visibility="Collapsed" Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="SurveyIcon" FontSize="30" Glyph="" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="SurveyTitle" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="SurveyTitleText" TextWrapping="Wrap" Text="未命名问卷" />
                            <TextBlock x:Name="SurveyProviderBadge" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource QuestionChoiceBrush}" Text="问卷星" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnEditAnswers"
                            AutomationProperties.Name="编辑逐题答案"
                            AutomationProperties.AutomationId="SurveyEditAnswersButton">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Edit" /><TextBlock Text="编辑逐题答案" /></StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="总题数" />
                            <TextBlock x:Name="TotalCount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="SurveyTotalCountText" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="已配置" />
                            <TextBlock x:Name="ConfiguredCount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="SurveyConfiguredCountText" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="AI 题" />
                            <TextBlock x:Name="AICount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="SurveyAiCountText" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Style="{StaticResource StatsLabelStyle}" Text="异常" />
                            <TextBlock x:Name="ProblemCount" Style="{StaticResource StatsValueStyle}" AutomationProperties.AutomationId="SurveyProblemCountText" Text="0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 空态 -->
            <Border x:Name="EmptyHint" Style="{StaticResource SectionCardBorder}">
                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,8">
                    <FontIcon FontSize="28" Glyph="&#xE8A5;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未导入问卷。粘贴链接解析，或扫描二维码、导入既有配置。" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
