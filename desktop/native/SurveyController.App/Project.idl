    runtimeclass OptionWeight : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        OptionWeight(String label, Double initialValue, Double minimum, Double maximum, Double step);
        String Label { get; };
        Double Value;
        Double Minimum { get; };
        Double Maximum { get; };
        Double Step { get; };
    }

    runtimeclass IPUsageRow
    {
        IPUsageRow(String label, Double total, Double maximum);
        String Label { get; };
        Double Total { get; };
        Double Maximum { get; };
        String CountText { get; };
    }

