<Page
    x:Class="SurveyController.App.Views.MorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:SurveyController.App.ViewModels">

    <Page.Resources>
        <Style x:Key="MoreCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ui:SimpleStackPanel Margin="24,24,24,32" HorizontalAlignment="Left" Spacing="16" MaxWidth="800">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="更多" />

            <Border Style="{StaticResource MoreCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="80" Height="80" Margin="0,0,16,0" VerticalAlignment="Top" Source="/Assets/appicon.png" Stretch="Uniform" />
                    <ui:SimpleStackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="SurveyController" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="高效的自动化问卷填写工具" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="当前版本 v5.0.0" />
                    </ui:SimpleStackPanel>
                </Grid>
            </Border>

            <Border Padding="16" Background="#18F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Top" Symbol="Important" />
                    <TextBlock Grid.Column="1" Text="本项目仅供学习交流使用，禁止用于恶意滥用行为。" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Style="{StaticResource MoreCardStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="更新" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="当前版本" />
                        <ui:SimpleStackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" Text="v5.0.0" />
                            <TextBlock x:Name="PublishDate" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="" />
                        </ui:SimpleStackPanel>
                    </Grid>
                    <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="点击检查新版本" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReleaseNotes" Visibility="Collapsed" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdateButton" Content="检查更新" Click="OnCheckUpdate" />
                        <Button x:Name="DownloadButton" IsEnabled="False" Content="下载安装包" Click="OnOpenDownload" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource MoreCardStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="相关链接" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="GitHub 仓库" Click="OnOpenRepository" />
                        <Button Content="官方文档" Click="OnOpenTutorial" />
                        <Button Content="查看许可证" Click="OnOpenLicense" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource MoreCardStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="项目致谢" />
                    <TextBlock Text="License：GPL-3.0 License" />
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock Text="贡献者" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource TextButtonStyle}" Content="@HUNGRY_M0" Click="OnOpenContributor1" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource TextButtonStyle}" Content="@shiahonb777" Click="OnOpenContributor2" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource TextButtonStyle}" Content="@BingBuLiang" Click="OnOpenContributor3" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource TextButtonStyle}" Content="@dAwn-Rebirth" Click="OnOpenContributor4" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource TextButtonStyle}" Content="@Moyuin-aka" Click="OnOpenContributor5" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource TextButtonStyle}" Content="@qintaiyang" Click="OnOpenContributor6" />
                    </ui:SimpleStackPanel>
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="服务条款与隐私声明" />
                        <Button Content="查看详情" Click="OnOpenTerms" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Expander x:Name="DonationExpander" HorizontalAlignment="Stretch" Header="支持作者" Margin="0,0,0,12">
                <ui:SimpleStackPanel Margin="0,12,0,4" Spacing="16">
                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="如果这个项目对你有帮助，欢迎请作者喝杯奶茶。" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SimpleStackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="微信赞赏" />
                            <Image Width="200" Height="200" HorizontalAlignment="Left" Source="/Assets/WeDonate.png" Stretch="Uniform" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Grid.Column="1" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="支付宝" />
                            <Image Width="200" Height="200" HorizontalAlignment="Left" Source="/Assets/AliDonate.jpg" Stretch="Uniform" />
                        </ui:SimpleStackPanel>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="感谢每一位支持者，你们的鼓励是持续更新的动力。" TextWrapping="Wrap" />
                </ui:SimpleStackPanel>
            </Expander>

            <Expander x:Name="IPUsageExpander" Header="IP 使用记录" Margin="0,0,0,12">
                <ui:SimpleStackPanel Margin="0,12,0,4" Spacing="10">
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新记录" Click="OnLoadIpUsage" />
                        <TextBlock x:Name="IPBalance" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="IP 池剩余数量：未加载" />
                    </ui:SimpleStackPanel>
                    <TextBlock x:Name="IPUsageStatus" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="" TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding UsageItems}" MaxHeight="360" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:IpUsageRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Maximum="{Binding Maximum}" Value="{Binding Total}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding CountText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ui:SimpleStackPanel>
            </Expander>

            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="Copyright © 2026 HUNGRY_M0. All rights reserved." />
        </ui:SimpleStackPanel>
    </ScrollViewer>
</Page>
