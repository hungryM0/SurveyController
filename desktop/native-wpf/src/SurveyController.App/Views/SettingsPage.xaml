<Page
    x:Class="SurveyController.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,20,0,8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ui:SimpleStackPanel Margin="24,24,24,32" HorizontalAlignment="Left" Spacing="4" MaxWidth="800">
            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold" Text="设置" />

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="界面外观" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Setting" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="主题" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="选择应用使用的颜色模式" />
                    </ui:SimpleStackPanel>
                    <ComboBox
                        x:Name="ThemeMode"
                        Grid.Column="2" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center"
                        SelectedIndex="{Binding ViewModel.ThemeModeIndex, Mode=TwoWay}"
                        SelectionChanged="OnSettingSelectionChanged">
                        <ComboBoxItem Content="跟随系统" Tag="system" />
                        <ComboBoxItem Content="浅色" Tag="light" />
                        <ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="GlobalNavigationButton" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="显示选中导航名称" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="开启后左侧导航会显示当前选中项的文字标签" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="ShowNavigationText"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.ShowNavigationText, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Pin" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="窗口置顶" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="开启后程序窗口始终保持在最上层" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="Topmost"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.Topmost, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="行为设置" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Save" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="关闭前询问是否保存" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="关闭窗口时提示是否保存当前配置" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="AskSaveOnClose"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.AskSaveOnClose, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="View" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="执行期间阻止自动休眠" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="任务运行时阻止电脑因长时间无操作而休眠，任务结束后自动恢复" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="PreventSleep"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.PreventSleep, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Help" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="后台任务完成/失败时通知" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="程序不在前台时，任务完成或失败会弹出系统通知" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="TaskNotification"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.TaskResultNotification, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Send" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="提交结果遥测" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="启用随机 IP 时，将提交结果同步上报服务端做统计，便于排查问题" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="Telemetry"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.SubmissionReportTelemetry, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Document" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="日志保留数量" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="自动保存运行日志，只保留最近几份历史记录" TextWrapping="Wrap" />
                    </ui:SimpleStackPanel>
                    <ComboBox
                        x:Name="LogCount"
                        Grid.Column="2" Width="124" HorizontalAlignment="Right" VerticalAlignment="Center"
                        SelectedIndex="{Binding ViewModel.LogCountIndex, Mode=TwoWay}"
                        SelectionChanged="OnSettingSelectionChanged">
                        <ComboBoxItem Content="3 份" Tag="3" />
                        <ComboBoxItem Content="5 份" Tag="5" />
                        <ComboBoxItem Content="10 份" Tag="10" />
                        <ComboBoxItem Content="20 份" Tag="20" />
                        <ComboBoxItem Content="30 份" Tag="30" />
                        <ComboBoxItem Content="50 份" Tag="50" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="软件更新" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Sync" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="启动时检查更新" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="发现新版本时提示下载" />
                    </ui:SimpleStackPanel>
                    <ui:ToggleSwitch
                        x:Name="AutoCheckUpdate"
                        Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsOn="{Binding ViewModel.AutoCheckUpdate, Mode=TwoWay}"
                        Toggled="OnSettingToggled" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="系统工具" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Refresh" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="恢复默认设置" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="恢复所有设置项的默认值" />
                    </ui:SimpleStackPanel>
                    <Button
                        x:Name="ResetAction"
                        Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="恢复默认" Click="OnReset" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="Folder" />
                    <ui:SimpleStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="16" Text="配置目录" />
                        <TextBlock
                            x:Name="ConfigDirectory"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding ViewModel.ConfigDirectory, Mode=OneWay}" />
                    </ui:SimpleStackPanel>
                    <Button
                        x:Name="ConfigDirectoryAction"
                        Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="选择目录" Click="OnChooseDirectory" />
                </Grid>
            </Border>

            <TextBlock
                x:Name="StatusText"
                Margin="0,12,0,0" HorizontalAlignment="Right"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{Binding ViewModel.StatusText, Mode=OneWay}" />
        </ui:SimpleStackPanel>
    </ScrollViewer>
</Page>
