<UserControl
    x:Class="SurveyController.App.Views.TaskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:controls="clr-namespace:SurveyController.App.Controls"
    xmlns:local="clr-namespace:SurveyController.App.Views"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="WizardShell" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition x:Name="FooterRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部向导进度与步骤标题 -->
                <Grid Margin="32,10,32,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StepSummary" VerticalAlignment="Center" Style="{DynamicResource SubtitleTextBlockStyle}" Text="第 1/6 步：导入问卷" />
                    <controls:StepCapsuleBar x:Name="StepCapsuleIndicator" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <Rectangle Grid.Row="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <!-- 主工作区：6 个向导步骤 + 1 个任务运行面板 -->
                <Grid Grid.Row="2">
                    <!-- 第 1 步：导入问卷 -->
                    <ScrollViewer x:Name="SurveyPanel" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel MaxWidth="720" Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Document" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="导入问卷" />
                            </ui:SimpleStackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ImportActionColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SurveyUrl" ui:ControlHelper.Header="问卷地址" ui:ControlHelper.PlaceholderText="粘贴 HTTP / HTTPS 问卷链接" TextChanged="OnSurveyUrlChanged" Margin="0,0,12,0" />
                                <Button x:Name="SurveyPrimaryButton" Grid.Column="1" VerticalAlignment="Bottom" Style="{DynamicResource AccentButtonStyle}" Click="OnPrimary">
                                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:SymbolIcon x:Name="SurveyPrimaryIcon" Symbol="Refresh" />
                                        <TextBlock x:Name="SurveyPrimaryLabel" Text="解析并继续" />
                                    </ui:SimpleStackPanel>
                                </Button>
                            </Grid>

                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Click="OnChooseQRCode">
                                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:SymbolIcon Symbol="View" />
                                        <TextBlock Text="识别二维码图片" />
                                    </ui:SimpleStackPanel>
                                </Button>
                                <Button Click="OnImportConfig">
                                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:SymbolIcon Symbol="Document" />
                                        <TextBlock Text="导入配置文件 (.json)" />
                                    </ui:SimpleStackPanel>
                                </Button>
                            </ui:SimpleStackPanel>

                            <!-- 引导提示卡片 -->
                            <Border
                                Margin="0,16,0,0"
                                Padding="16"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ui:SimpleStackPanel Spacing="12">
                                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:SymbolIcon Symbol="Help" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                        <TextBlock FontWeight="SemiBold" Text="使用提示与支持平台" />
                                    </ui:SimpleStackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SimpleStackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="1. 智能解析" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="支持问卷星、腾讯问卷、见数 (Credamo) 等主流平台，自动识别所有题型结构。"
                                                TextWrapping="Wrap" />
                                        </ui:SimpleStackPanel>
                                        <ui:SimpleStackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                            <TextBlock FontWeight="SemiBold" Text="2. 策略与信度" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="支持选项均分/配额自定义、心理测量信度 α 校验，以及大模型智能简答生成。"
                                                TextWrapping="Wrap" />
                                        </ui:SimpleStackPanel>
                                        <ui:SimpleStackPanel Grid.Column="2" Spacing="4" Margin="12,0,0,0">
                                            <TextBlock FontWeight="SemiBold" Text="3. 防护与风控" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="内置动态时间节奏拟真、随机浏览器指纹 (UA) 与高质量代理池对接，保障任务平稳。"
                                                TextWrapping="Wrap" />
                                        </ui:SimpleStackPanel>
                                    </Grid>
                                </ui:SimpleStackPanel>
                            </Border>
                        </ui:SimpleStackPanel>
                    </ScrollViewer>

                    <!-- 第 2 步：自定义答案 -->
                    <ScrollViewer x:Name="AnswersPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel MaxWidth="720" Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Edit" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="答案策略" />
                            </ui:SimpleStackPanel>
                            <Border Padding="16" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="10">
                                <ui:SimpleStackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="AnswerStatsThirdColumn" Width="*" />
                                            <ColumnDefinition x:Name="AnswerStatsFourthColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SimpleStackPanel Spacing="2">
                                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="总题数" />
                                            <TextBlock x:Name="AnswerTotalCount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                        </ui:SimpleStackPanel>
                                        <ui:SimpleStackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="已配置" />
                                            <TextBlock x:Name="AnswerConfiguredCount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                        </ui:SimpleStackPanel>
                                        <ui:SimpleStackPanel x:Name="AnswerAIPanel" Grid.Column="2" Spacing="2">
                                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="AI 题" />
                                            <TextBlock x:Name="AnswerAICount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                        </ui:SimpleStackPanel>
                                        <ui:SimpleStackPanel x:Name="AnswerProblemPanel" Grid.Column="3" Spacing="2">
                                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="异常" />
                                            <TextBlock x:Name="AnswerProblemCount" FontSize="24" FontWeight="SemiBold" Text="0" />
                                        </ui:SimpleStackPanel>
                                    </Grid>
                                    <Button x:Name="EditAnswersButton" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}" Click="OnEditAnswers">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:SymbolIcon Symbol="Edit" />
                                            <TextBlock Text="编辑逐题答案" />
                                        </ui:SimpleStackPanel>
                                    </Button>
                                </ui:SimpleStackPanel>
                            </Border>
                        </ui:SimpleStackPanel>
                    </ScrollViewer>

                    <!-- 第 3 步：条件规则 -->
                    <ScrollViewer x:Name="RulesPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Important" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="条件规则" />
                            </ui:SimpleStackPanel>
                            <local:RuleEditor x:Name="RuleEditorView" />
                        </ui:SimpleStackPanel>
                    </ScrollViewer>

                    <!-- 第 4 步：随机 IP / UA / 指定信度 -->
                    <ScrollViewer x:Name="NetworkPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel MaxWidth="720" Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Sync" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="网络与信度" />
                            </ui:SimpleStackPanel>

                            <!-- 代理状态摘要 -->
                            <Border Padding="12,8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SimpleStackPanel Spacing="2">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="代理来源" />
                                        <TextBlock x:Name="ProxyStatusSource" FontWeight="SemiBold" Text="直连" />
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="可用额度" />
                                        <TextBlock x:Name="ProxyStatusQuota" FontWeight="SemiBold" Text="不适用" />
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="IP 池状态" />
                                        <TextBlock x:Name="ProxyStatusPool" FontWeight="SemiBold" Text="不适用" />
                                    </ui:SimpleStackPanel>
                                </Grid>
                            </Border>

                            <!-- 访问方式与代理配置 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProxyMode" ui:ControlHelper.Header="访问方式" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnProxyModeChanged" Margin="0,0,12,0">
                                    <ComboBoxItem Content="直连" Tag="direct" />
                                    <ComboBoxItem Content="固定代理" Tag="fixed" />
                                    <ComboBoxItem Content="随机 IP" Tag="random" />
                                </ComboBox>
                                <Border x:Name="ProxySourceRow" Grid.Column="1" Visibility="Collapsed">
                                    <ComboBox x:Name="ProxySource" ui:ControlHelper.Header="代理来源" Width="200" SelectedIndex="0" SelectionChanged="OnProxySourceChanged">
                                        <ComboBoxItem Content="默认代理" Tag="default" />
                                        <ComboBoxItem Content="限时福利" Tag="benefit" />
                                        <ComboBoxItem Content="自定义代理" Tag="custom" />
                                    </ComboBox>
                                </Border>
                            </Grid>

                            <Border x:Name="FixedProxyRow" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FixedProxyAddress" ui:ControlHelper.Header="固定代理地址" ui:ControlHelper.PlaceholderText="http://127.0.0.1:8080" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnTestFixedProxy">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="测试连接" />
                                        </ui:SimpleStackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="CustomProxyRow" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CustomProxyApi" ui:ControlHelper.Header="代理 API 地址" ui:ControlHelper.PlaceholderText="https://..." Margin="0,0,8,0" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnTestCustomProxy">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="测试连接" />
                                        </ui:SimpleStackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="ProxyAreaRow" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProxyProvince" ui:ControlHelper.Header="省份" ui:ControlHelper.PlaceholderText="不限制" HorizontalAlignment="Stretch" SelectionChanged="OnProxyProvinceChanged" Margin="0,0,12,0" />
                                    <ComboBox x:Name="ProxyCity" Grid.Column="1" ui:ControlHelper.Header="城市" ui:ControlHelper.PlaceholderText="不限制" HorizontalAlignment="Stretch" SelectionChanged="OnProxyCityChanged" Margin="0,0,12,0" />
                                    <Button x:Name="SyncProxyButton" Grid.Column="2" VerticalAlignment="Bottom" Click="OnSyncProxy">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:SymbolIcon Symbol="Sync" />
                                            <TextBlock Text="同步额度" />
                                        </ui:SimpleStackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />

                            <!-- 极简控制行 -->
                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="随机 User-Agent 身份" />
                                <ui:ToggleSwitch x:Name="RandomUA" HorizontalAlignment="Right" OffContent="关" OnContent="开" />
                            </Grid>

                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="量表信度拟真 (Cronbach's α)" />
                                <ui:ToggleSwitch x:Name="PsychometricsEnabled" HorizontalAlignment="Right" OffContent="关" OnContent="开" Toggled="OnPsychometricsToggled" />
                            </Grid>

                            <Border x:Name="PsychometricsRow" Visibility="Collapsed">
                                <ui:NumberBox x:Name="TargetAlpha" Header="目标信度 α (推荐 0.75 ~ 0.90)" Width="220" HorizontalAlignment="Left"
                                           Minimum="0.5" Maximum="0.99" SmallChange="0.01" LargeChange="0.05" SpinButtonPlacementMode="Compact" />
                            </Border>
                        </ui:SimpleStackPanel>
                    </ScrollViewer>

                    <!-- 第 5 步：作答时长 / 间隔时长 / 作答时间 -->
                    <ScrollViewer x:Name="TimingPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel MaxWidth="720" Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Refresh" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="时间与节奏" />
                            </ui:SimpleStackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="TimingSecondColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SimpleStackPanel Spacing="12" Margin="0,0,16,0">
                                    <TextBlock FontWeight="SemiBold" Text="单份作答时长（秒）" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:NumberBox x:Name="AnswerDurationMin" Header="最短" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" Margin="0,0,8,0" />
                                        <ui:NumberBox x:Name="AnswerDurationMax" Grid.Column="1" Header="最长" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </ui:SimpleStackPanel>

                                <ui:SimpleStackPanel x:Name="SubmitIntervalPanel" Grid.Column="1" Spacing="12">
                                    <TextBlock FontWeight="SemiBold" Text="提交间隔冷却（秒）" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:NumberBox x:Name="SubmitIntervalMin" Header="最短" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" Margin="0,0,8,0" />
                                        <ui:NumberBox x:Name="SubmitIntervalMax" Grid.Column="1" Header="最长" Minimum="0" Maximum="1800" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </ui:SimpleStackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />

                            <TextBlock FontWeight="SemiBold" Text="有效作答时间窗口" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="WindowSecondColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SimpleStackPanel Spacing="8" Margin="0,0,16,0">
                                    <DatePicker x:Name="WindowStartDate" ui:ControlHelper.Header="开始日期" HorizontalAlignment="Stretch" />
                                    <TextBox x:Name="WindowStartTime" ui:ControlHelper.Header="开始时间" ui:ControlHelper.PlaceholderText="00:00:00" HorizontalAlignment="Stretch" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel x:Name="WindowEndPanel" Grid.Column="1" Spacing="8">
                                    <DatePicker x:Name="WindowEndDate" ui:ControlHelper.Header="结束日期" HorizontalAlignment="Stretch" />
                                    <TextBox x:Name="WindowEndTime" ui:ControlHelper.Header="结束时间" ui:ControlHelper.PlaceholderText="23:59:59" HorizontalAlignment="Stretch" />
                                </ui:SimpleStackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />

                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="连续失败时自动停止" />
                                <ui:ToggleSwitch x:Name="FailStop" HorizontalAlignment="Right" OffContent="关" OnContent="开" />
                            </Grid>

                            <Grid MinHeight="36">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="遇到验证码时自动暂停" />
                                <ui:ToggleSwitch x:Name="PauseCaptcha" HorizontalAlignment="Right" OffContent="关" OnContent="开" />
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />

                            <Grid MinHeight="36">
                                <ui:SimpleStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Excel 反填" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="按表格内容覆盖对应答案" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ReverseFillButton" Click="OnChooseReverseFill">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:SymbolIcon Symbol="OpenFile" />
                                            <TextBlock x:Name="ReverseFillButtonLabel" Text="选择 Excel" />
                                        </ui:SimpleStackPanel>
                                    </Button>
                                    <ui:ToggleSwitch x:Name="ReverseFillEnabled" OffContent="关" OnContent="开" />
                                </ui:SimpleStackPanel>
                            </Grid>
                        </ui:SimpleStackPanel>
                    </ScrollViewer>

                    <!-- 第 6 步：目标份数 / 并发数 / 开始作答 -->
                    <ScrollViewer x:Name="LaunchPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel MaxWidth="720" Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Send" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="规模与启动" />
                            </ui:SimpleStackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="LaunchSecondColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:NumberBox x:Name="TargetCount" Header="目标提交份数" Minimum="1" Maximum="999999" SpinButtonPlacementMode="Compact" Margin="0,0,16,0" />
                                <ui:NumberBox x:Name="ThreadCount" Grid.Column="1" Header="并发线程数" Minimum="1" Maximum="128" SpinButtonPlacementMode="Compact" />
                            </Grid>

                            <TextBlock FontWeight="SemiBold" Text="任务配置摘要" Margin="0,4,0,0" />
                            <ui:SimpleStackPanel Spacing="0">
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="问卷标题" />
                                    <TextBlock x:Name="ReviewSurvey" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="平台与题目" />
                                    <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="ReviewProvider" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ReviewQuestions" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </ui:SimpleStackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="规模与并发" />
                                    <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="ReviewTarget" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ReviewThreads" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </ui:SimpleStackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="网络与信度" />
                                    <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:Name="ReviewNetwork" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ReviewReliability" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </ui:SimpleStackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="作答时长" />
                                    <TextBlock x:Name="ReviewDuration" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid MinHeight="36">
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="问卷地址" />
                                    <TextBlock x:Name="ReviewUrl" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </Grid>
                            </ui:SimpleStackPanel>

                            <ListBox x:Name="CheckProblems" Margin="0,4,0,0" />
                        </ui:SimpleStackPanel>
                    </ScrollViewer>

                    <!-- 运行态：任务运行与实时监控 -->
                    <ScrollViewer x:Name="RunPanel" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:SimpleStackPanel MaxWidth="800" Margin="32,24" HorizontalAlignment="Left" Spacing="16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SymbolIcon Symbol="Send" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="任务运行" />
                            </ui:SimpleStackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="1" Value="0" Height="8" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock x:Name="RunProgressText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="0 / 0" />
                            </Grid>

                            <Border x:Name="RunResultCard" Visibility="Collapsed" Padding="16,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SimpleStackPanel Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="成功份数" />
                                        <TextBlock x:Name="RunResultSuccess" FontSize="20" FontWeight="SemiBold" Text="0" />
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="失败份数" />
                                        <TextBlock x:Name="RunResultFail" FontSize="20" FontWeight="SemiBold" Text="0" />
                                    </ui:SimpleStackPanel>
                                    <ui:SimpleStackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="提交合计" />
                                        <TextBlock x:Name="RunResultTotal" FontSize="20" FontWeight="SemiBold" Text="0" />
                                    </ui:SimpleStackPanel>
                                </Grid>
                            </Border>

                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PauseButton" Content="暂停任务" IsEnabled="False" Click="OnPauseRun" />
                                <Button x:Name="ResumeButton" Content="继续任务" IsEnabled="False" Click="OnResumeRun" />
                                <Button x:Name="StopButton" Content="停止任务" IsEnabled="False" Click="OnStopRun" />
                                <Button x:Name="ExportResultButton" Visibility="Collapsed" Content="导出作答结果" Click="OnExportResult" />
                            </ui:SimpleStackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="260" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="实时日志" />
                                    <Button x:Name="ExportLogsButton" Visibility="Collapsed" HorizontalAlignment="Right" Content="导出日志" Click="OnExportLogs" />
                                </Grid>
                                <ListBox x:Name="RunLogs" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding LogLines, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>
                        </ui:SimpleStackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底栏：返回、下一步 / 启动按钮 -->
                <Rectangle x:Name="FooterDivider" Grid.Row="3" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Grid x:Name="FooterBar" Grid.Row="4" Margin="32,0">
                    <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BackButton" Click="OnBack">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Back" />
                                <TextBlock Text="返回上一步" />
                            </ui:SimpleStackPanel>
                        </Button>
                        <Button x:Name="PrimaryButton" Style="{DynamicResource AccentButtonStyle}" Click="OnPrimary">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon x:Name="PrimaryButtonIcon" Symbol="Forward" />
                                <TextBlock x:Name="PrimaryButtonLabel" Text="继续" />
                            </ui:SimpleStackPanel>
                        </Button>
                    </ui:SimpleStackPanel>
                </Grid>
            </Grid>

            <!-- 浮动通知与状态展示 InfoBar -->
            <ui:SimpleStackPanel x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Spacing="8" IsHitTestVisible="True">
                <controls:InfoBar x:Name="SurveyStatus" IsOpen="False" IsClosable="False" MaxWidth="720" />
                <controls:InfoBar x:Name="NetworkStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="直连" Message="不使用代理访问问卷。" />
                <controls:InfoBar x:Name="CheckStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="尚未检查配置" Message="点击底部按钮检查整套配置并启动作答。" />
                <controls:InfoBar x:Name="RunStatus" IsOpen="False" IsClosable="False" MaxWidth="720" Severity="Informational" Title="尚未启动" Message="配置保存后可以启动任务。" />
                <controls:InfoBar x:Name="RunExportStatus" IsOpen="False" IsClosable="False" MaxWidth="720" />
            </ui:SimpleStackPanel>
        </Grid>
    </Grid>
</UserControl>
