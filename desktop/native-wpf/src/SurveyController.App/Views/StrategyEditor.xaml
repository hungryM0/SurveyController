<UserControl
    x:Class="SurveyController.App.Views.StrategyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:controls="clr-namespace:SurveyController.App.Controls"
    xmlns:local="clr-namespace:SurveyController.App.ViewModels"
    Loaded="OnLoaded">

    <Grid MinHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="EditorSearchColumn" Width="280" />
            </Grid.ColumnDefinitions>
            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Edit" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="逐题答案" />
                <TextBlock x:Name="QuestionCountSummary" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </ui:SimpleStackPanel>
            <ui:SimpleStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                <Button x:Name="PreviousQuestionButton" Width="36" Height="36" Click="OnPreviousQuestion" ToolTip="上一题"><ui:SymbolIcon Symbol="Back" /></Button>
                <Button x:Name="NextQuestionButton" Width="36" Height="36" Click="OnNextQuestion" ToolTip="下一题"><ui:SymbolIcon Symbol="Forward" /></Button>
            </ui:SimpleStackPanel>
            <ui:AutoSuggestBox x:Name="QuestionSearch" Grid.Column="2" PlaceholderText="查找题号、题干或选项" QueryIcon="Find" TextChanged="OnQuestionSearchChanged" SuggestionChosen="OnQuestionSuggestionChosen" QuerySubmitted="OnQuestionQuerySubmitted" />
        </Grid>

        <Grid x:Name="QuestionEditorPanel" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QuestionTreeColumn" Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="QuestionDetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                <TreeView x:Name="QuestionTree" SelectedItemChanged="OnQuestionSelected" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" />
            </Border>

            <Border x:Name="QuestionDetailHost" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer x:Name="QuestionDetailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <ui:SimpleStackPanel Margin="16" Spacing="16">
                        <ui:SimpleStackPanel Spacing="8">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <ui:FontIcon x:Name="QuestionTypeIcon" FontSize="18" />
                                <TextBlock x:Name="QuestionTitle" FontSize="20" FontWeight="SemiBold" Text="选择题目" TextWrapping="Wrap" />
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                                    <Border x:Name="QuestionTypeInfoBadge" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
                                    <ui:FontIcon x:Name="QuestionBadgeIcon" FontSize="12" />
                                    <TextBlock x:Name="QuestionTypeBadge" Style="{StaticResource WizardBadgeTextStyle}" Text="题型" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel x:Name="RequiredBadgeBorder" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                    <Border x:Name="RequiredBadgeInfo" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource RequiredBadgeForegroundBrush}" />
                                    <TextBlock x:Name="RequiredBadge" Style="{StaticResource WizardBadgeTextStyle}" Foreground="{DynamicResource RequiredBadgeForegroundBrush}" Text="必答" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel x:Name="LogicBadgeBorder" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                    <Border x:Name="LogicBadgeInfo" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource LogicBadgeForegroundBrush}" />
                                    <TextBlock x:Name="LogicBadge" Style="{StaticResource WizardBadgeTextStyle}" Foreground="{DynamicResource LogicBadgeForegroundBrush}" Text="逻辑" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel x:Name="UnsupportedBadgeBorder" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                    <Border x:Name="UnsupportedBadgeInfo" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource UnsupportedBadgeForegroundBrush}" />
                                    <TextBlock x:Name="UnsupportedBadge" Style="{StaticResource WizardBadgeTextStyle}" Foreground="{DynamicResource UnsupportedBadgeForegroundBrush}" Text="暂不支持" />
                                </ui:SimpleStackPanel>
                            </ui:SimpleStackPanel>
                            <TextBlock x:Name="QuestionMeta" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                        </ui:SimpleStackPanel>

                        <Expander x:Name="WeightSettingsSection" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <Grid>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="答案分布" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="倾向预设与选项比例" />
                                </Grid>
                            </Expander.Header>
                            <ui:SimpleStackPanel Margin="0,12,0,0" Spacing="12">
                                <ui:RadioButtons x:Name="Bias" Header="倾向预设" MaxColumns="4" SelectedIndex="0" SelectionChanged="OnBiasChanged">
                                    <RadioButton Content="自定义" Tag="custom" />
                                    <RadioButton Content="偏左" Tag="left" />
                                    <RadioButton Content="居中" Tag="center" />
                                    <RadioButton Content="偏右" Tag="right" />
                                </ui:RadioButtons>
                                <ui:SimpleStackPanel x:Name="OptionWeightsSection" Spacing="8">
                                    <Grid>
                                        <TextBlock FontWeight="SemiBold" Text="选项比例" VerticalAlignment="Center" />
                                        <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ResetEvenWeightsButton" Content="均分" Padding="8,2" FontSize="12" Click="OnResetEvenWeights" ToolTip="平均分配所有选项权重" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="拖动滑块调整" />
                                        </ui:SimpleStackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="OptionWeightRows">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ui:SimpleStackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:OptionWeight}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}" />
                                                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="4" Padding="5,2">
                                                        <TextBlock Text="{Binding PercentageText}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                                    </Border>
                                                    <ui:NumberBox Grid.Column="3" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="{Binding Step}" SpinButtonPlacementMode="Compact" Value="{Binding Value, Mode=TwoWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RatioPreview" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" TextWrapping="Wrap" />
                                </ui:SimpleStackPanel>
                                <TextBlock x:Name="OptionWeightEmpty" Visibility="Collapsed" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="此题无需设置选项比例" />
                            </ui:SimpleStackPanel>
                        </Expander>

                        <Expander x:Name="QuestionSpecificSettingsSection" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.Header><TextBlock FontSize="16" FontWeight="SemiBold" Text="题型专属设置" /></Expander.Header>
                            <ui:SimpleStackPanel Margin="0,12,0,0" Spacing="12">
                                <ui:SimpleStackPanel x:Name="TextQuestionSection" Spacing="12">
                                    <ui:RadioButtons x:Name="TextRandomMode" Header="填空模式" MaxColumns="3" SelectionChanged="OnTextModeChanged">
                                        <RadioButton Content="答案文本" Tag="none" />
                                        <RadioButton Content="随机姓名" Tag="name" />
                                        <RadioButton Content="随机手机号" Tag="mobile" />
                                        <RadioButton Content="随机身份证" Tag="id_card" />
                                        <RadioButton Content="随机整数" Tag="integer" />
                                    </ui:RadioButtons>
                                    <TextBox x:Name="TextAnswers" ui:ControlHelper.Header="答案文本" ui:ControlHelper.PlaceholderText="每行一个候选答案" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" TextChanged="OnQuestionTextChanged" />
                                    <Grid x:Name="TextRangeRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:NumberBox x:Name="TextRangeMin" Header="整数最小值" SpinButtonPlacementMode="Compact" ValueChanged="OnQuestionNumberChanged" />
                                        <ui:NumberBox x:Name="TextRangeMax" Grid.Column="2" Header="整数最大值" SpinButtonPlacementMode="Compact" ValueChanged="OnQuestionNumberChanged" />
                                    </Grid>
                                    <ui:ToggleSwitch x:Name="AIEnabled" Header="允许 AI 填空" OffContent="关" OnContent="开" Toggled="OnAIEnabledToggled" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel x:Name="FillableOptionsSection" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="可填写选项" />
                                    <ui:SimpleStackPanel x:Name="FillableOptionList" Spacing="8" />
                                </ui:SimpleStackPanel>
                                <Grid x:Name="LocationSection">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition x:Name="LocationCityColumn" Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition x:Name="LocationDistrictColumn" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocationProvince" ui:ControlHelper.Header="省" TextChanged="OnQuestionTextChanged" />
                                    <TextBox x:Name="LocationCity" Grid.Column="2" ui:ControlHelper.Header="市" TextChanged="OnQuestionTextChanged" />
                                    <TextBox x:Name="LocationDistrict" Grid.Column="4" ui:ControlHelper.Header="区县" TextChanged="OnQuestionTextChanged" />
                                </Grid>
                                <ui:SimpleStackPanel x:Name="MultiTextSection" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="多项填空" />
                                    <TextBox x:Name="MultiTextAnswers" ui:ControlHelper.Header="答案文本组合" ui:ControlHelper.PlaceholderText="每行一组，各空用 || 分隔" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" TextChanged="OnQuestionTextChanged" />
                                    <ui:SimpleStackPanel x:Name="MultiTextRows" Spacing="8" />
                                </ui:SimpleStackPanel>
                                <ui:SimpleStackPanel x:Name="AttachedOptionSection" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="嵌入式下拉" />
                                    <ui:SimpleStackPanel x:Name="AttachedOptionSelectList" Spacing="8" />
                                </ui:SimpleStackPanel>
                            </ui:SimpleStackPanel>
                        </Expander>
                    </ui:SimpleStackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <ui:SimpleStackPanel x:Name="StatusPanel" Grid.Row="2" Spacing="8" Margin="0,8,0,0">
            <controls:InfoBar x:Name="QuestionStatus" IsOpen="False" IsClosable="False" MaxWidth="720" />
        </ui:SimpleStackPanel>
    </Grid>
</UserControl>
