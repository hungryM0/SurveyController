<UserControl
    x:Class="SurveyController.App.Views.StrategyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App.ViewModels"
    Loaded="OnLoaded">
    <Grid MinHeight="520" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactQuestionEditor">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorSearchRow.Height" Value="Auto" />
                        <Setter Target="EditorSearchColumn.Width" Value="0" />
                        <Setter Target="QuestionSearch.(Grid.Row)" Value="1" />
                        <Setter Target="QuestionSearch.(Grid.Column)" Value="0" />
                        <Setter Target="QuestionSearch.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="QuestionTreeColumn.Width" Value="*" />
                        <Setter Target="QuestionDetailColumn.Width" Value="0" />
                        <Setter Target="QuestionTreeRow.Height" Value="250" />
                        <Setter Target="QuestionDetailRow.Height" Value="*" />
                        <Setter Target="QuestionDetailHost.(Grid.Row)" Value="1" />
                        <Setter Target="QuestionDetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="LocationCityColumn.Width" Value="0" />
                        <Setter Target="LocationDistrictColumn.Width" Value="0" />
                        <Setter Target="LocationCityRow.Height" Value="Auto" />
                        <Setter Target="LocationDistrictRow.Height" Value="Auto" />
                        <Setter Target="LocationCity.(Grid.Row)" Value="1" />
                        <Setter Target="LocationCity.(Grid.Column)" Value="0" />
                        <Setter Target="LocationDistrict.(Grid.Row)" Value="2" />
                        <Setter Target="LocationDistrict.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideQuestionEditor">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorSearchRow.Height" Value="0" />
                        <Setter Target="EditorSearchColumn.Width" Value="280" />
                        <Setter Target="QuestionSearch.(Grid.Row)" Value="0" />
                        <Setter Target="QuestionSearch.(Grid.Column)" Value="2" />
                        <Setter Target="QuestionSearch.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="QuestionTreeColumn.Width" Value="300" />
                        <Setter Target="QuestionDetailColumn.Width" Value="*" />
                        <Setter Target="QuestionTreeRow.Height" Value="*" />
                        <Setter Target="QuestionDetailRow.Height" Value="0" />
                        <Setter Target="QuestionDetailHost.(Grid.Row)" Value="0" />
                        <Setter Target="QuestionDetailHost.(Grid.Column)" Value="1" />
                        <Setter Target="LocationCityColumn.Width" Value="*" />
                        <Setter Target="LocationDistrictColumn.Width" Value="*" />
                        <Setter Target="LocationCityRow.Height" Value="0" />
                        <Setter Target="LocationDistrictRow.Height" Value="0" />
                        <Setter Target="LocationCity.(Grid.Row)" Value="0" />
                        <Setter Target="LocationCity.(Grid.Column)" Value="1" />
                        <Setter Target="LocationDistrict.(Grid.Row)" Value="0" />
                        <Setter Target="LocationDistrict.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="EditorSearchColumn" Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EditorSearchRow" Height="0" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <SymbolIcon Symbol="Edit" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="逐题答案" />
                <TextBlock x:Name="QuestionCountSummary" VerticalAlignment="Center" AutomationProperties.AutomationId="StrategyCountSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PreviousQuestionButton" Width="36" Height="36" Click="OnPreviousQuestion" AutomationProperties.Name="上一题" AutomationProperties.AutomationId="StrategyPreviousButton" ToolTipService.ToolTip="上一题"><SymbolIcon Symbol="Back" /></Button>
                <Button x:Name="NextQuestionButton" Width="36" Height="36" Click="OnNextQuestion" AutomationProperties.Name="下一题" AutomationProperties.AutomationId="StrategyNextButton" ToolTipService.ToolTip="下一题"><SymbolIcon Symbol="Forward" /></Button>
            </StackPanel>
            <AutoSuggestBox x:Name="QuestionSearch" Grid.Column="2" PlaceholderText="查找题号、题干或选项" QueryIcon="Find" TextChanged="OnQuestionSearchChanged" SuggestionChosen="OnQuestionSuggestionChosen" QuerySubmitted="OnQuestionQuerySubmitted" AutomationProperties.Name="搜索题目" AutomationProperties.AutomationId="StrategySearchBox" />
        </Grid>

        <Grid x:Name="QuestionEditorPanel" Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QuestionTreeColumn" Width="300" />
                <ColumnDefinition x:Name="QuestionDetailColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="QuestionTreeRow" Height="*" />
                <RowDefinition x:Name="QuestionDetailRow" Height="0" />
            </Grid.RowDefinitions>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource WizardCardCornerRadius}" Padding="8">
                <TreeView x:Name="QuestionTree" SelectionMode="Single" SelectionChanged="OnQuestionSelected" ItemInvoked="OnQuestionInvoked" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="问卷题目结构" AutomationProperties.AutomationId="StrategyQuestionTree">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Content}" HorizontalContentAlignment="Stretch" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Border x:Name="QuestionDetailHost" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource WizardCardCornerRadius}">
                <ScrollViewer x:Name="QuestionDetailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <StackPanel Padding="16" Spacing="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="QuestionTypeIcon" FontSize="18" />
                                <TextBlock x:Name="QuestionTitle" FontSize="21" FontWeight="SemiBold" AutomationProperties.AutomationId="StrategyQuestionTitleText" Text="选择题目" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <InfoBadge x:Name="QuestionTypeInfoBadge" Width="8" Height="8" VerticalAlignment="Center" />
                                    <FontIcon x:Name="QuestionBadgeIcon" FontSize="12" />
                                    <TextBlock x:Name="QuestionTypeBadge" Style="{StaticResource WizardBadgeTextStyle}" AutomationProperties.AutomationId="StrategyTypeBadgeText" Text="题型" />
                                </StackPanel>
                                <StackPanel x:Name="RequiredBadgeBorder" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                    <InfoBadge x:Name="RequiredBadgeInfo" Width="8" Height="8" VerticalAlignment="Center" Background="{ThemeResource RequiredBadgeForegroundBrush}" />
                                    <TextBlock x:Name="RequiredBadge" Style="{StaticResource WizardBadgeTextStyle}" Foreground="{ThemeResource RequiredBadgeForegroundBrush}" Text="必答" />
                                </StackPanel>
                                <StackPanel x:Name="LogicBadgeBorder" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                    <InfoBadge x:Name="LogicBadgeInfo" Width="8" Height="8" VerticalAlignment="Center" Background="{ThemeResource LogicBadgeForegroundBrush}" />
                                    <TextBlock x:Name="LogicBadge" Style="{StaticResource WizardBadgeTextStyle}" Foreground="{ThemeResource LogicBadgeForegroundBrush}" Text="逻辑" />
                                </StackPanel>
                                <StackPanel x:Name="UnsupportedBadgeBorder" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                    <InfoBadge x:Name="UnsupportedBadgeInfo" Width="8" Height="8" VerticalAlignment="Center" Background="{ThemeResource UnsupportedBadgeForegroundBrush}" />
                                    <TextBlock x:Name="UnsupportedBadge" Style="{StaticResource WizardBadgeTextStyle}" Foreground="{ThemeResource UnsupportedBadgeForegroundBrush}" Text="暂不支持" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="QuestionMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="StrategyQuestionMetaText" TextWrapping="Wrap" />
                        </StackPanel>

                        <Expander x:Name="WeightSettingsSection" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="StrategyWeightSettingsExpander">
                            <Expander.Header>
                                <Grid ColumnSpacing="12">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="答案分布" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="倾向预设与选项比例" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Padding="0,12,0,0" Spacing="12">
                                <RadioButtons x:Name="Bias" Header="倾向预设" MaxColumns="4" SelectedIndex="0" SelectionChanged="OnBiasChanged" AutomationProperties.Name="选项倾向" AutomationProperties.AutomationId="StrategyBiasComboBox">
                                    <RadioButton Content="自定义" Tag="custom" AutomationProperties.AutomationId="StrategyBiasCustomButton" />
                                    <RadioButton Content="偏左" Tag="left" AutomationProperties.AutomationId="StrategyBiasLeftButton" />
                                    <RadioButton Content="居中" Tag="center" AutomationProperties.AutomationId="StrategyBiasCenterButton" />
                                    <RadioButton Content="偏右" Tag="right" AutomationProperties.AutomationId="StrategyBiasRightButton" />
                                </RadioButtons>
                                <StackPanel x:Name="OptionWeightsSection" Spacing="8">
                                    <Grid><TextBlock FontWeight="SemiBold" Text="选项比例" /><TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="拖动滑块调整" /></Grid>
                                    <ItemsRepeater x:Name="OptionWeightRows" AutomationProperties.AutomationId="StrategyWeightRows">
                                        <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="local:OptionWeight">
                                                <Grid ColumnSpacing="12" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
                                                    <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" StepFrequency="{x:Bind Step}" Value="{x:Bind Value, Mode=TwoWay}" AutomationProperties.Name="选项比例滑块" />
                                                    <NumberBox Grid.Column="2" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" SmallChange="{x:Bind Step}" SpinButtonPlacementMode="Compact" Value="{x:Bind Value, Mode=TwoWay}" AutomationProperties.Name="选项比例" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock x:Name="RatioPreview" Foreground="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.AutomationId="StrategyRatioPreviewText" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="OptionWeightEmpty" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="此题无需设置选项比例" />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="QuestionSpecificSettingsSection" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="StrategyQuestionSettingsExpander">
                            <Expander.Header><TextBlock FontSize="16" FontWeight="SemiBold" Text="题型专属设置" /></Expander.Header>
                            <StackPanel Padding="0,12,0,0" Spacing="12">
                                <StackPanel x:Name="TextQuestionSection" Spacing="12">
                                    <RadioButtons x:Name="TextRandomMode" Header="填空模式" MaxColumns="3" SelectionChanged="OnTextModeChanged" AutomationProperties.Name="填空模式" AutomationProperties.AutomationId="StrategyTextModeButtons">
                                        <RadioButton Content="答案文本" Tag="none" />
                                        <RadioButton Content="随机姓名" Tag="name" />
                                        <RadioButton Content="随机手机号" Tag="mobile" />
                                        <RadioButton Content="随机身份证" Tag="id_card" />
                                        <RadioButton Content="随机整数" Tag="integer" />
                                    </RadioButtons>
                                    <TextBox x:Name="TextAnswers" Header="答案文本" PlaceholderText="每行一个候选答案" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" TextChanged="OnQuestionTextChanged" AutomationProperties.Name="填空答案文本" AutomationProperties.AutomationId="StrategyTextAnswersInput" />
                                    <Grid x:Name="TextRangeRow" Visibility="Collapsed" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox x:Name="TextRangeMin" Header="整数最小值" AutomationProperties.AutomationId="StrategyTextRangeMinBox" SpinButtonPlacementMode="Compact" ValueChanged="OnQuestionNumberChanged" />
                                        <NumberBox x:Name="TextRangeMax" Grid.Column="1" Header="整数最大值" AutomationProperties.AutomationId="StrategyTextRangeMaxBox" SpinButtonPlacementMode="Compact" ValueChanged="OnQuestionNumberChanged" />
                                    </Grid>
                                    <ToggleSwitch x:Name="AIEnabled" Header="允许 AI 填空" OffContent="关" OnContent="开" Toggled="OnAIEnabledToggled" AutomationProperties.Name="允许 AI 填空" AutomationProperties.AutomationId="StrategyAiEnabledToggle" />
                                </StackPanel>
                                <StackPanel x:Name="FillableOptionsSection" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="可填写选项" />
                                    <StackPanel x:Name="FillableOptionList" Spacing="8" AutomationProperties.Name="可填写选项列表" />
                                </StackPanel>
                                <Grid x:Name="LocationSection" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LocationCityColumn" Width="*" /><ColumnDefinition x:Name="LocationDistrictColumn" Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="LocationCityRow" Height="0" /><RowDefinition x:Name="LocationDistrictRow" Height="0" /></Grid.RowDefinitions>
                                    <TextBox x:Name="LocationProvince" Header="省" AutomationProperties.AutomationId="StrategyLocationProvinceInput" TextChanged="OnQuestionTextChanged" />
                                    <TextBox x:Name="LocationCity" Grid.Column="1" Header="市" AutomationProperties.AutomationId="StrategyLocationCityInput" TextChanged="OnQuestionTextChanged" />
                                    <TextBox x:Name="LocationDistrict" Grid.Column="2" Header="区县" AutomationProperties.AutomationId="StrategyLocationDistrictInput" TextChanged="OnQuestionTextChanged" />
                                </Grid>
                                <StackPanel x:Name="MultiTextSection" Spacing="8"><TextBlock FontWeight="SemiBold" Text="多项填空" /><TextBox x:Name="MultiTextAnswers" Header="答案文本组合" PlaceholderText="每行一组，各空用 || 分隔" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" TextChanged="OnQuestionTextChanged" AutomationProperties.Name="多项填空答案文本" AutomationProperties.AutomationId="StrategyMultiTextInput" /><StackPanel x:Name="MultiTextRows" Spacing="8" /></StackPanel>
                                <StackPanel x:Name="AttachedOptionSection" Spacing="8"><TextBlock FontWeight="SemiBold" Text="嵌入式下拉" /><StackPanel x:Name="AttachedOptionSelectList" Spacing="8" AutomationProperties.Name="嵌入式下拉选项" /></StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel x:Name="StatusPanel" Grid.Row="2" Spacing="8">
            <InfoBar x:Name="QuestionStatus" IsOpen="False" IsClosable="False" MaxWidth="720" AutomationProperties.AutomationId="StrategyQuestionStatus" />
        </StackPanel>
    </Grid>
</UserControl>
