<Application
    x:Class="SurveyController.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurveyController.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ShellTitleBarHeight">48</x:Double>
            <x:Double x:Key="ShellNavigationWidth">68</x:Double>
            <x:Double x:Key="PageGutter">24</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
                <Setter Property="MinHeight" Value="84" />
                <Setter Property="Padding" Value="20,16" />
            </Style>
            <Style x:Key="FormRowCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="ContentDialog">
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
