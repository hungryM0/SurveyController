<Page
    x:Class="SurveyController.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="22,18,22,28" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="设置" />
                <Border HorizontalAlignment="Right" Padding="10,5" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="12">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="3 组设置" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" Text="界面外观" />
                        <Grid MinHeight="44"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="主题" /><ComboBox x:Name="ThemeMode" Width="176" HorizontalAlignment="Right"><ComboBoxItem Content="跟随系统" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" /></ComboBox></Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="44"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="导航文字" /><ToggleSwitch x:Name="ShowNavigationText" HorizontalAlignment="Right" OffContent="关" OnContent="开" /></Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="44"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="窗口背景效果" /><ToggleSwitch x:Name="MicaEnabled" HorizontalAlignment="Right" OffContent="关" OnContent="开" /></Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" Text="行为设置" />
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal" Spacing="8"><Button Content="选择目录" Click="OnChooseDirectory" /><Button Content="恢复默认" Click="OnReset" /></StackPanel>
                        <Grid MinHeight="40"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="窗口置顶" /><ToggleSwitch x:Name="Topmost" HorizontalAlignment="Right" /></Grid>
                        <Grid MinHeight="40"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="关闭前询问是否保存" /><ToggleSwitch x:Name="AskSaveOnClose" HorizontalAlignment="Right" /></Grid>
                        <Grid MinHeight="40"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="执行期间阻止自动休眠" /><ToggleSwitch x:Name="PreventSleep" HorizontalAlignment="Right" /></Grid>
                        <Grid MinHeight="40"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="后台任务完成/失败时通知" /><ToggleSwitch x:Name="TaskNotification" HorizontalAlignment="Right" /></Grid>
                        <Grid MinHeight="40"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="提交结果遥测" /><ToggleSwitch x:Name="Telemetry" HorizontalAlignment="Right" /></Grid>
                        <Grid MinHeight="40"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="自动保存日志" /><ToggleSwitch x:Name="AutoSaveLogs" HorizontalAlignment="Right" /></Grid>
                        <Grid MinHeight="44"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="日志保留数量" /><ComboBox x:Name="LogCount" Width="176" HorizontalAlignment="Right"><x:Int32>3</x:Int32><x:Int32>5</x:Int32><x:Int32>10</x:Int32><x:Int32>20</x:Int32><x:Int32>30</x:Int32><x:Int32>50</x:Int32></ComboBox></Grid>
                        <TextBox x:Name="ConfigDirectory" Header="配置目录" IsReadOnly="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" Text="更新设置" />
                    <Grid MinHeight="44"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="在应用程序启动时检查更新" /><ToggleSwitch x:Name="AutoCheckUpdate" HorizontalAlignment="Right" /></Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource AccentButtonStyle}" Content="保存设置" Click="OnSave" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
