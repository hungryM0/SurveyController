<Page
    x:Class="SurveyController.App.MorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Margin="36,28,36,40" HorizontalAlignment="Left" Spacing="8">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="关于" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Sync" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="16" Text="更新" /><TextBlock x:Name="UpdateStatus" Style="{StaticResource SettingsDescriptionStyle}" Text="点击检查新版本" /></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"><Button Content="下载安装包" Click="OnOpenDownload" /><Button Content="重新检查" Click="OnCheckUpdate" /></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Document" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="16" Text="SurveyController" /><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="版本 5.0.0 · GPL-3.0" /></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"><Button Content="查看文档" Click="OnOpenDocs" /><Button Content="查看协议" Click="OnOpenTerms" /></StackPanel>
                </Grid>
            </Border>
            <Expander Header="赞助支持" Margin="0,12,0,0">
                <StackPanel Padding="0,12,0,4" HorizontalAlignment="Left" Spacing="16">
                    <StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="微信赞赏" /><Image Width="220" Height="220" Source="ms-appx:///Assets/WeDonate.png" Stretch="Uniform" /></StackPanel>
                    <StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="支付宝" /><Image Width="220" Height="220" Source="ms-appx:///Assets/AliDonate.jpg" Stretch="Uniform" /></StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
