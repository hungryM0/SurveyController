<UserControl
    x:Class="SurveyController.App.StrategyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MinHeight="520">
        <TabView IsAddTabButtonVisible="False">
            <TabViewItem Header="逐题设置" IsClosable="False">
                <Grid x:Name="QuestionEditorLayout" Padding="0,10,0,0" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="QuestionListColumn" Width="*" />
                        <ColumnDefinition x:Name="QuestionDetailColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="QuestionListRow" Height="220" />
                        <RowDefinition x:Name="QuestionDetailRow" Height="*" />
                    </Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CompactQuestionEditor" />
                            <VisualState x:Name="WideQuestionEditor">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="720" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="QuestionListColumn.Width" Value="0.3*" />
                                    <Setter Target="QuestionDetailColumn.Width" Value="0.7*" />
                                    <Setter Target="QuestionListRow.Height" Value="*" />
                                    <Setter Target="QuestionDetailRow.Height" Value="0" />
                                    <Setter Target="QuestionDetailScroll.(Grid.Row)" Value="0" />
                                    <Setter Target="QuestionDetailScroll.(Grid.Column)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="QuestionList" SelectionChanged="OnQuestionSelected" />
                    </Border>
                    <ScrollViewer x:Name="QuestionDetailScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="4,0,10,12" Spacing="12">
                            <TextBlock x:Name="QuestionTitle" FontSize="17" FontWeight="SemiBold" Text="选择题目" TextWrapping="Wrap" />
                            <TextBlock x:Name="QuestionMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="Dimension" Header="题目维度" PlaceholderText="输入维度名称" />
                                <ComboBox x:Name="Bias" Grid.Column="1" Header="倾向预设" SelectedIndex="0" SelectionChanged="OnBiasChanged"><ComboBoxItem Content="自定义" Tag="custom" /><ComboBoxItem Content="偏左" Tag="left" /><ComboBoxItem Content="居中" Tag="center" /><ComboBoxItem Content="偏右" Tag="right" /></ComboBox>
                            </Grid>
                            <StackPanel x:Name="OptionWeightsSection" Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="选项比例" />
                                <StackPanel x:Name="OptionWeightRows" Spacing="14" />
                                <TextBlock x:Name="RatioPreview" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="OptionWeightEmpty" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="此题无需设置选项比例" />
                            <ToggleSwitch x:Name="AIEnabled" Header="AI 填空" OffContent="关" OnContent="开" />
                            <Expander Header="题型高级设置">
                                <StackPanel Padding="0,10,0,2" Spacing="10">
                                    <TextBox x:Name="FillableOptions" Header="可填选项" PlaceholderText="选项序号，例如 1, 3" />
                                    <TextBox x:Name="OptionFillTexts" Header="附加填空" PlaceholderText="用 | 分隔多个答案" />
                                    <ComboBox x:Name="TextRandomMode" Header="随机文本模式" SelectedIndex="0" SelectionChanged="OnTextModeChanged"><ComboBoxItem Content="默认答案" Tag="" /><ComboBoxItem Content="随机姓名" Tag="name" /><ComboBoxItem Content="随机手机号" Tag="mobile" /><ComboBoxItem Content="随机身份证号" Tag="id_card" /><ComboBoxItem Content="随机整数" Tag="integer" /></ComboBox>
                                    <Grid x:Name="TextRangeRow" Visibility="Collapsed" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="TextRangeMin" Header="随机整数最小值" SpinButtonPlacementMode="Compact" /><NumberBox x:Name="TextRangeMax" Grid.Column="1" Header="随机整数最大值" SpinButtonPlacementMode="Compact" /></Grid>
                                    <TextBox x:Name="LocationParts" Header="地区选择" PlaceholderText="省份 | 城市 | 区县" />
                                    <TextBox x:Name="MultiTextModes" Header="多项填空模式" PlaceholderText="每个填空一项，用 | 分隔" />
                                    <TextBox x:Name="MultiTextAIFlags" Header="多项填空 AI" PlaceholderText="例如 0, 1, 0" />
                                    <TextBox x:Name="MultiTextRanges" Header="多项填空整数范围" PlaceholderText="例如 1-10 | 20-30" />
                                    <TextBox x:Name="AttachedOptionSelects" Header="嵌入式下拉" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" PlaceholderText="JSON 数组" />
                                </StackPanel>
                            </Expander>
                            <InfoBar x:Name="QuestionStatus" IsOpen="False" IsClosable="False" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="保存题目设置" Click="OnSaveQuestion" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="条件规则" IsClosable="False">
                <Grid Padding="0,10,0,0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.36*" /><ColumnDefinition Width="0.64*" /></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="新增规则" Click="OnNewRule" /><Button Content="删除规则" Click="OnDeleteRule" /></StackPanel><ListView x:Name="RuleList" Grid.Row="1" Margin="0,10,0,0" SelectionChanged="OnRuleSelected" /></Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="2,0,10,12" Spacing="10">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="条件与动作" />
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="ConditionQuestion" Header="条件题号" Minimum="1" SpinButtonPlacementMode="Compact" /><ComboBox x:Name="ConditionMode" Grid.Column="1" Header="条件" SelectedIndex="0"><ComboBoxItem Content="已选中" Tag="selected" /><ComboBoxItem Content="未选中" Tag="not_selected" /></ComboBox></Grid>
                            <TextBox x:Name="ConditionOptions" Header="条件选项序号" PlaceholderText="例如 1, 3" />
                            <TextBox x:Name="ConditionRow" Header="条件矩阵行序号" PlaceholderText="非矩阵题留空" />
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="TargetQuestion" Header="目标题号" Minimum="1" SpinButtonPlacementMode="Compact" /><ComboBox x:Name="ActionMode" Grid.Column="1" Header="动作" SelectedIndex="0"><ComboBoxItem Content="必须选择" Tag="must_select" /><ComboBoxItem Content="不得选择" Tag="must_not_select" /></ComboBox></Grid>
                            <TextBox x:Name="TargetOptions" Header="目标选项序号" PlaceholderText="例如 2" />
                            <TextBox x:Name="TargetRow" Header="目标矩阵行序号" PlaceholderText="非矩阵题留空" />
                            <InfoBar x:Name="RuleStatus" IsOpen="False" IsClosable="False" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="保存条件规则" Click="OnSaveRule" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="维度分组" IsClosable="False">
                <StackPanel Padding="12" Spacing="12">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="维度分组" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="每行一个维度。题目保存维度时会继续沿用这里的名称。" TextWrapping="Wrap" />
                    <TextBox x:Name="DimensionsText" AcceptsReturn="True" MinHeight="220" TextWrapping="Wrap" />
                    <InfoBar x:Name="DimensionStatus" IsOpen="False" IsClosable="False" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="保存维度分组" Click="OnSaveDimensions" />
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
