<Page
    x:Class="SurveyController.App.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" Margin="24,24,24,32" HorizontalAlignment="Stretch" Spacing="12">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideCommunityLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{StaticResource DesktopBreakpointWidth}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CommunityQrColumn.Width" Value="Auto" />
                            <Setter Target="CommunityQr.(Grid.Column)" Value="2" />
                            <Setter Target="CommunityQr.(Grid.Row)" Value="0" />
                            <Setter Target="CommunityQr.Margin" Value="0" />
                            <Setter Target="IssueActionColumn.Width" Value="Auto" />
                            <Setter Target="IssueAction.(Grid.Column)" Value="2" />
                            <Setter Target="IssueAction.(Grid.Row)" Value="0" />
                            <Setter Target="IssueAction.Margin" Value="0" />
                            <Setter Target="LicenseActionColumn.Width" Value="Auto" />
                            <Setter Target="LicenseAction.(Grid.Column)" Value="2" />
                            <Setter Target="LicenseAction.(Grid.Row)" Value="0" />
                            <Setter Target="LicenseAction.Margin" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /><RepositionThemeTransition /></TransitionCollection></StackPanel.ChildrenTransitions>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="社区" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="CommunityQrColumn" Width="0" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Message" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="16" Text="QQ 群交流" /><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="扫描二维码加入群聊" /></StackPanel>
                    <Image x:Name="CommunityQr" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Width="128" Height="128" HorizontalAlignment="Left" Source="ms-appx:///Assets/community_qr.png" Stretch="Uniform" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="IssueActionColumn" Width="0" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Message" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="16" Text="问题反馈" /><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="提交可复现的问题" /></StackPanel>
                    <Button x:Name="IssueAction" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="提交 Issue" Click="OnOpenIssues" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LicenseActionColumn" Width="0" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Document" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="16" Text="开源许可" /><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="GPL-3.0" /></StackPanel>
                    <Button x:Name="LicenseAction" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="查看许可证" Click="OnOpenLicense" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
